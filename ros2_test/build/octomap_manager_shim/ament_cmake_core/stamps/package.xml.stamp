<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>octomap_manager_shim</name>
  <version>0.0.1</version>
  <description>
    5-method OctomapManager-replacement shim (ARCHITECTURE.md Section 12.3),
    written directly against octomap::OcTree instead of porting
    volumetric_mapping. Shared library so exploration_cpp and search_cpp
    both consume the same map-query implementation instead of each
    re-implementing it (see Open Issue #4 for why that's worth avoiding).
    No ROS dependency - plain C++ against liboctomap only.
  </description>
  <maintainer email="hamdan@example.com">hamdan</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>octomap</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
