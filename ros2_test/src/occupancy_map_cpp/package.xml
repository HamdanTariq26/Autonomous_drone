<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>occupancy_map_cpp</name>
  <version>0.0.1</version>
  <description>
    OctoMap-based occupancy mapping node for tello_autonomy. Consumes
    TOPIC_CURRENT_POSE_METRIC / TOPIC_CURRENT_POINTS_METRIC and publishes
    an octomap_msgs/Octomap on TOPIC_OCCUPANCY_GRID for exploration_cpp /
    search_cpp to consume. See ARCHITECTURE.md Section 12.2.
  </description>
  <maintainer email="hamdan@example.com">hamdan</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>octomap_ros</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>libpcl-all-dev</depend>
  <depend>tello_autonomy_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
